{
  "description": "Non-runtime V4 Hook reference for the H00-H20 campaign. The authoritative installed candidate manifest is hooks/hooks.json; tests require this hooks object to remain exactly equivalent.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "spawn_agent|followup_task|interrupt_agent|list_agents|send_message|collaborationspawn_agent|collaborationfollowup_task|collaborationinterrupt_agent|collaborationlist_agents|collaborationsend_message",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-python.sh\" \"${PLUGIN_ROOT}/scripts/orchestration_guard.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-python.cmd\" \"%PLUGIN_ROOT%\\scripts\\orchestration_guard.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "spawn_agent|followup_task|interrupt_agent|list_agents|send_message|collaborationspawn_agent|collaborationfollowup_task|collaborationinterrupt_agent|collaborationlist_agents|collaborationsend_message",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-python.sh\" \"${PLUGIN_ROOT}/scripts/orchestration_guard.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-python.cmd\" \"%PLUGIN_ROOT%\\scripts\\orchestration_guard.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "subagents_dispatch_reader|subagents_dispatch_worker|subagents_dispatch_investigator|subagents_dispatch_solver|subagents_dispatch_advisor",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-python.sh\" \"${PLUGIN_ROOT}/scripts/orchestration_guard.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-python.cmd\" \"%PLUGIN_ROOT%\\scripts\\orchestration_guard.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ]
  }
}
