  "invariants": {
    "I01": "A canonical workspace has at most one managed writer lease in RESERVED, HELD, REVOKING, or UNKNOWN.",
    "I02": "Host COMPLETED never directly marks a WorkUnit ACCEPTED or unlocks dependencies.",
    "I03": "Dependencies unlock only from WorkUnit ACCEPTED.",
    "I04": "A Host observation whose execution_id, unit_id, attempt_no, control_epoch, or lease_epoch basis is stale is discarded.",
    "I05": "A writing followup or continue must reserve or retain WriterLease before Host reactivation.",
    "I06": "An interrupt result alone never releases WriterLease.",
    "I07": "UNKNOWN writer ownership blocks conflicting managed mutation and replacement execution.",
    "I08": "Main is the sole managed coordinator; managed children must not create or control descendants. Profile configuration and project max_depth express the product boundary but do not prove Host-hard descendant isolation.",
    "I09": "Unresolved V3.x live state is never silently migrated into V4 execution.",
    "I10": "Plan-only orchestration never acquires WriterLease.",
    "I11": "Main must acquire the same WriterLease abstraction before managed integration writes.",
    "I12": "Main verifies candidate artifacts and mutation scope before WorkUnit acceptance.",
    "I13": "Ordinary correctness depends on native Host lifecycle truth, bounded local state, Main reconciliation, WorkUnit acceptance, and WriterLease settlement.",
    "I14": "The product admits at most four concurrently active managed child executions.",
    "I15": "Semantic-read Programmer/Product Manager executions may overlap each other under broader Host permission only with no active canonical WriterLease and a before/after artifact-immutability guard; Host-proven read-only is the stronger assurance path."
  },
  "migration": {
