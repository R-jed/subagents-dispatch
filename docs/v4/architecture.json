      "mutation_authority": "none",
      "semantic_role": "work"
    },
    "solver": {
      "effort": "high",
      "model": "gpt-5.6-sol",
      "mutation_authority": "bounded-source-write",
      "semantic_role": "work"
    },
    "worker": {
      "effort": "max",
      "model": "gpt-5.6-luna",
      "mutation_authority": "bounded-source-write",
      "semantic_role": "work"
    }
  },
  "public_skills": [
    "orchestrate",
    "doctor"
  ],
  "reconciliation": {
    "host_completed_maps_to_work_unit": "RESULT_READY",
    "mode": "main_driven_native_host_reconciliation",
    "observation_basis": [
      "execution_id",
      "control_epoch",
      "lease_epoch"
    ],
    "persist_pre_tool_basis": false,
    "stale_observation_action": "discard"
  },
  "release": {
    "freeze_after_implementation_and_verification": true,
    "host_campaign": [
      "N0_route_model_effort_fork_turns",
      "N1_child_collaboration_absent",
      "N2_spawn_identity_binding",
      "N3_capacity_rejection_no_materialization",
      "N4_followup_continue_same_child",
      "N5_interrupt_settlement",
      "N6_writer_takeover_settlement",
      "N7_rollout_reconciliation_privacy",
      "N8_final_review_and_sandbox_truth"
    ]
  },
  "review": {
    "artifact_mutation_invalidates_verdict": true,
    "exact_artifact_binding": true,
    "fresh_reviewer": true,
    "reviewer_profile": "advisor"
  },
  "routing": {
    "dynamic_reasoning_effort": false,
    "peer_messaging_on_correctness_path": false,
    "principle": "lowest_eligible_capability_profile"
  },
  "scheduler": {
    "acceptance_backpressure_threshold": 2,
    "host_capacity_token_required": false,
    "host_rejection_is_capacity_authority": true,
    "known_host_capacity_is_advisory_ceiling": true,
    "unknown_host_capacity_blocks_spawn": false
  },
  "schema_version": "4.0.0-native-core-candidate-2",
  "semantic_roles": [
    "main",
    "work",
    "review"
  ],
  "state": {
    "bounded_bytes": 65536,
    "compact_work_graph": true,
    "database": false,
    "raw_prompts_or_transcripts": false,
    "state_revision": true,
    "storage": "active.json",
    "temporary_thread_scoped": true,
    "top_level_fields": [
      "schema_version",
      "root_session_id",
      "state_revision",
      "team_plan_revision",
      "work_units",
      "executions",
      "writer_lease",
      "accounting_refs",
      "created_at",
      "updated_at",
      "locale"
    ]
  },
  "work_unit": {
    "dependency_unlock_state": "ACCEPTED",
    "host_completed_unlocks_dependency": false,
    "states": [
