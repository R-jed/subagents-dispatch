{
  "authorities": {
    "mutation_authority_values": [
      "none",
      "declared-output-only",
      "bounded-source-write"
    ],
    "writer_owner_kinds": [
      "main",
      "execution"
    ]
  },
  "control_semantics": {
    "CONTINUE": {
      "host_primitive": "followup",
      "increments_attempt": false,
      "increments_followup_count": false
    },
    "FOLLOWUP": {
      "host_primitive": "followup",
      "increments_attempt": false,
      "increments_followup_count": true
    },
    "INTERRUPT": {
      "host_primitive": "interrupt",
      "interrupt_result_releases_writer": false,
      "requires_current_generation_settlement": true
    },
    "TAKEOVER": {
      "host_primitive": "composite",
      "requires_writer_settlement_before_main_acquire": true
    }
  },
  "delegation": {
    "fork_turns": "none",
    "initial_managed_children_max": 2,
    "max_depth": 1,
    "product_managed_children_max": 3
  },
  "entities": {
    "ExecutionBinding": {
      "fields": [
        "execution_id",
        "unit_id",
        "team_plan_revision",
        "attempt_no",
        "profile_id",
        "agent_id",
        "native_task_name",
        "model",
        "effort",
        "granted_authority",
        "granted_write_scope",
        "workspace_id",
        "lifecycle",
        "control_epoch",
        "followup_count",
        "failure_origin",
        "blocker",
        "quarantine_reason"
      ]
    },
    "WorkUnit": {
      "fields": [
        "unit_id",
        "intent",
        "goal",
        "output",
        "depends_on",
        "state",
        "ownership",
        "authority_ceiling",
        "write_scope_ceiling",
        "done_when",
        "accepted_result_ref",
        "accepted_execution_id",
        "accepted_control_epoch"
      ],
      "optional_fields": [
        "responsibility_context"
      ],
      "managed_spawn_required_context_fields": [
        "interfaces",
        "invariants",
        "decision_boundary",
        "accepted_evidence_refs",
        "do_not_redo",
        "stop_boundary"
      ]
    },
    "WriterLease": {
      "fields": [
        "lease_id",
        "lease_epoch",
        "workspace_id",
        "unit_id",
        "owner_kind",
        "owner_id",
        "state"
      ]
    }
  },
  "excluded_from_v4_0_0": [
    "dynamic_reasoning_effort",
    "nested_delegation",
    "automatic_worktree_manager",
    "parallel_isolated_writers",
    "peer_delegation",
    "persistent_scheduler_database",
    "daemon_scheduler",
    "plugin_hook_correctness_dependency",
    "pending_control_protocol",
    "operation_intent_receipt_ledger"
  ],
  "execution": {
    "control_epoch_scope": "execution_binding",
    "fresh_agent_attempt_limit": 2,
    "same_child_followup_consumes_fresh_attempt": false,
    "states": [
      "SPAWN_PENDING",
      "RUNNING",
      "INTERRUPTED",
      "COMPLETED",
      "FAILED",
      "UNKNOWN",
      "CLOSED"
    ]
  },
  "host_capability_requirements": [
    "spawn",
    "observe",
    "wait_or_wakeup",
    "followup",
    "interrupt",
    "fresh_context_spawn"
  ],
  "managed_profile_requirements": [
    "child_collaboration_disabled"
  ],
  "host_truth": {
    "capacity_owner": "codex_host",
    "child_identity_owner": "codex_host",
    "lifecycle_owner": "codex_host",
    "materialization_owner": "codex_host",
    "plugin_hook_required": false
  },
  "invariants": {
    "I01": "A canonical workspace has at most one managed writer lease in RESERVED, HELD, REVOKING, or UNKNOWN.",
    "I02": "Host COMPLETED never directly marks a WorkUnit ACCEPTED or unlocks dependencies.",
    "I03": "Dependencies unlock only from WorkUnit ACCEPTED.",
    "I04": "A Host observation whose execution_id, control_epoch, or lease_epoch basis is stale is discarded.",
    "I05": "A writing followup or continue must reserve or retain WriterLease before Host reactivation.",
    "I06": "An interrupt result alone never releases WriterLease.",
    "I07": "UNKNOWN writer ownership blocks conflicting managed mutation and replacement execution.",
    "I08": "Managed children cannot control sibling managed agents under the verified profile contract.",
    "I09": "Unresolved V3.x live state is never silently migrated into V4 execution.",
    "I10": "Plan-only orchestration never acquires WriterLease.",
    "I11": "Main must acquire the same WriterLease abstraction before managed integration writes.",
    "I12": "Main verifies candidate artifacts and mutation scope before WorkUnit acceptance.",
    "I13": "Ordinary correctness does not depend on Plugin Hook, PendingControl, or a replacement request-receipt control plane."
  },
  "migration": {
    "silent_live_state_migration": false,
    "source_family": "V3.x",
    "unresolved_live_state": "fail_closed"
  },
  "profiles": {
    "advisor": {
      "effort": "high",
      "model": "gpt-5.6-sol",
      "mutation_authority": "none",
      "semantic_role": "review"
    },
    "investigator": {
      "effort": "high",
      "model": "gpt-5.6-terra",
      "mutation_authority": "none",
      "semantic_role": "work"
    },
    "reader": {
      "effort": "max",
