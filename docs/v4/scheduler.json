{
  "schema_version": "4.0.0-scheduler-4",
  "mode": "wakeup_driven_reconcile",
  "background_daemon": false,
  "wakeup_reasons": [
    "USER_INPUT",
    "AGENT_UPDATE",
    "AGENT_COMPLETED",
    "AGENT_BLOCKED",
    "CAPACITY_RELEASED",
    "REVIEW_FAILED",
    "USER_CANCEL"
  ],
  "dependency_truth": "WorkUnit.ACCEPTED",
  "host_completed_effect": "RESULT_READY",
  "host_capacity_owner": "codex_host",
  "known_host_capacity_is_advisory_ceiling": true,
  "unknown_host_capacity_blocks_spawn": false,
  "initial_managed_children_max": 2,
  "product_managed_children_max": 3,
  "progressive_refill": true,
  "priority": "longest_downstream_critical_path_then_unit_id",
  "phase_isolation": {
    "writable_batch_max": 1,
    "mix_read_and_write_in_same_launch_batch": false,
    "writer_lease_blocking_prevents_managed_launch": true
  },
  "backpressure": {
    "threshold_unaccepted_results": 2,
    "states": ["RESULT_READY", "VERIFYING"],
    "action": "stop_new_fresh_starts"
  },
  "unknown_execution_occupies_product_capacity": true,
  "plan_only_actions": 0,
  "host_not_execution_ready_actions": 0,
  "fresh_attempt_limit_per_work_unit": 2,
  "pre_materialization_host_rejection_consumes_attempt": false,
  "ambiguous_materialization": "ExecutionBinding.UNKNOWN"
}
