{
  "schema_version": "4.0.0-writer-lifecycle-5",
  "writer_lease": {
    "scope": "canonical_workspace",
    "states": ["RESERVED", "HELD", "REVOKING", "UNKNOWN", "RELEASED"],
    "blocking_states": ["RESERVED", "HELD", "REVOKING", "UNKNOWN"],
    "epoch_monotonic": true,
    "stale_release_allowed": false,
    "unknown_auto_release": false,
    "main_uses_same_abstraction": true,
    "security_boundary": "managed_orchestration_mutual_exclusion"
  },
  "settlement_theorem": {
    "requires": [
      "fresh current-generation Host observation",
      "matching execution_id",
      "matching control_epoch",
      "matching lease_epoch when present",
      "observed non-active Host lifecycle"
    ],
    "interrupt_return_alone_releases_writer": false
  },
  "same_child": {
    "fresh_attempt_increment": false,
    "followup_authorization": "new_correction_basis",
    "followup_count_is_diagnostic": true,
    "continue_increments_followup_count": false,
    "accepted_or_cancelled_reactivation": false
  },
  "takeover": {
    "sequence": [
      "WriterLease REVOKING",
      "native interrupt request when needed",
      "fresh current-generation Host observation",
      "execution observed non-active",
      "atomic WriterLease transfer to Main"
    ],
    "unknown_blocks_transfer": true,
    "unleased_transfer_gap": false
  },
  "runtime_validation": "N5_N6_required_before_supported_release"
}
