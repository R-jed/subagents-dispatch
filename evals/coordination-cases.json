{
  "schema_version": "1.0",
  "suite": "subagents-dispatch-coordination-contract",
  "cases": [
    {
      "id": "upstream-workflow-remains-authoritative",
      "input": {
        "task": "An upstream Skill already defines goal, stages, outputs, dependencies, and acceptance. Delegate useful execution without changing that workflow."
      },
      "expected": {
        "preserve_upstream_workflow": true,
        "delegate_may_assign": ["owner", "role", "concurrency", "write_isolation", "integration_timing"],
        "delegate_must_not_redefine": ["goal", "decomposition", "stage_order", "dependencies", "required_outputs", "business_acceptance", "quality_gates"]
      }
    },
    {
      "id": "decomposition-preserves-material-obligations",
      "input": {
        "task": "A task has several material acceptance obligations. Delegation splits the work across multiple responsibilities while Main retains one cross-cutting integration obligation."
      },
      "expected": {
        "semantic_coverage_required": true,
        "every_material_obligation_has_owner": true,
        "main_owned_obligation_allowed": true,
        "fixed_obligation_taxonomy_required": false
      }
    },
    {
      "id": "structural-validity-does-not-prove-semantic-coverage",
      "input": {
        "task": "A TeamPlan has valid unit IDs, an acyclic dependency graph, disjoint ownership, and a valid integration order, but one already-clear material user obligation disappeared during decomposition."
      },
      "expected": {
        "structural_plan_may_validate": true,
        "semantic_coverage_complete": false,
        "candidate_ready": false,
        "repair_decomposition_in_main": true,
        "contract_blocker": false
      }
    },
    {
      "id": "coverage-impossible-because-task-truth-missing-is-contract",
      "input": {
        "task": "Semantic coverage cannot be closed because a required acceptance fact is missing or contradictory in current task truth."
      },
      "expected": {
        "semantic_coverage_complete": false,
        "repair_decomposition_alone_sufficient": false,
        "blocker": "contract"
      }
    },
    {
      "id": "cross-unit-seam-can-remain-main-owned",
      "input": {
        "task": "Two delegated responsibilities each produce valid outputs, while user acceptance depends on a material relationship between those outputs. A separate child would add no value."
      },
      "expected": {
        "seam_requires_owner": true,
        "main_may_own_seam": true,
        "automatic_extra_child": false,
        "integration_order_alone_is_sufficient": false
      }
    },
    {
      "id": "downstream-review-waits-for-integrated-deliverable",
      "input": {
        "task": "Several predecessor units are accepted. A downstream review responsibility is defined to inspect the final integrated deliverable, but Main has not materialized that deliverable yet."
      },
      "expected": {
        "structurally_ready": true,
        "semantically_ready": false,
        "dispatch_review_now": false,
        "main_must_materialize_and_verify_integration_first": true
      }
    },
    {
      "id": "phase-transition-recompiles-without-inheriting-authority",
      "input": {
        "task": "An accepted read-only phase produces an actionable deliverable containing accepted evidence plus quoted or generated content. A later user instruction authorizes a materially different action phase whose responsibilities have different goals and outputs."
      },
      "expected": {
        "accepted_prior_truth_promoted": true,
        "whole_prior_artifact_trusted": false,
        "embedded_untrusted_content_remains_data": true,
        "fresh_responsibility_compilation": true,
        "repurpose_old_unit_when_goal_or_output_changes": false,
        "accepted_evidence_reusable_if_fresh": true,
        "later_authority_inherited_from_readiness": false,
        "authority_reassessed": true
      }
    },
    {
      "id": "isolated-files-shared-api-are-not-independent",
      "input": {
        "task": "Two proposed writers use separate physical checkouts and disjoint files, but one changes an API contract that the other consumes."
      },
      "expected": {
        "parallel_writes_allowed": false,
        "reason": "semantic_dependency",
        "filesystem_isolation_sufficient": false,
        "required_resolution": "explicit_dependency_or_integration_order"
      }
    },
    {
      "id": "verify-child-cannot-fix-source",
      "input": {
        "task": "A verification child discovers a source defect while checking acceptance."
      },
      "expected": {
        "intent": "verify",
        "mutation_authority": "none",
        "source_write_allowed": false,
        "on_required_source_change": "return_to_main_for_authority"
      }
    },
    {
      "id": "declared-output-does-not-grant-source-write",
      "input": {
        "task": "A child may update one named verification report but otherwise only inspects source."
      },
      "expected": {
        "intent": "verify",
        "mutation_authority": "declared-output-only",
        "source_write_allowed": false,
        "declared_output_write_allowed": true
      }
    },
    {
      "id": "independent-execution-ordered-integration",
      "input": {
        "task": "Two isolated writers implement against an already-stable interface. Both can make progress now, but the consumer result must be integrated only after the producer result is accepted."
      },
      "expected": {
        "execution_can_overlap": true,
        "consumer_integration_after": ["producer"],
        "main_is_integration_owner": true,
        "integrate_by_completion_time": false
      }
    },
    {
      "id": "unresolved-semantics-cannot-hide-behind-integration-order",
      "input": {
        "task": "A consumer implementation depends on an API behavior decision that has not been made yet."
      },
      "expected": {
        "ready_to_execute": false,
        "integration_after_is_sufficient": false,
        "reason": "semantic_truth_not_ready"
      }
    },
    {
      "id": "accepted-route-is-not-runtime-observation",
      "input": {
        "task": "The host accepted the requested child role and model, but it did not expose runtime model or effort telemetry."
      },
      "expected": {
        "requested_status": "declared",
        "accepted_status": "matched",
        "observed_status": "not_observed",
        "may_claim_observed_route": false
      }
    }
  ]
}
