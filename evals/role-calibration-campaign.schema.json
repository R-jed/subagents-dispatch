{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subagents-dispatch role calibration campaign",
  "type": "object",
  "required": [
    "schema_version",
    "campaign_id",
    "purpose",
    "plugin_candidate_sha",
    "host_target",
    "repeat_policy",
    "roles",
    "workloads"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "purpose": {"enum": ["exploratory", "policy_promotion", "single_agent_vs_dispatch"]},
    "plugin_candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host_target": {
      "type": "object",
      "required": ["product", "version", "platform"],
      "properties": {
        "product": {"const": "Codex"},
        "version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "repeat_policy": {
      "type": "object",
      "required": ["minimum_completed_per_arm", "ordering"],
      "properties": {
        "minimum_completed_per_arm": {"type": "integer", "minimum": 1},
        "ordering": {"enum": ["randomized", "interleaved", "fixed_with_reason"]},
        "fixed_order_reason": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "contract_ref", "control", "challengers"],
        "properties": {
          "role": {"enum": ["reader", "worker", "solver", "investigator", "advisor"]},
          "contract_ref": {"type": "string", "minLength": 1},
          "control": {"$ref": "#/$defs/route"},
          "challengers": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/route"}
          }
        },
        "additionalProperties": false
      }
    },
    "workloads": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "repository_url",
          "base_revision",
          "task_text",
          "task_sha256",
          "reset_procedure",
          "acceptance",
          "controls"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["reader", "worker", "solver", "investigator", "advisor"]},
          "repository_url": {"type": "string", "minLength": 1},
          "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_task_ref": {"type": ["string", "null"]},
          "task_text": {"type": "string", "minLength": 1},
          "task_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reset_procedure": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "acceptance": {
            "type": "object",
            "required": ["rubric_id", "oracle_kind", "verification"],
            "properties": {
              "rubric_id": {"type": "string", "minLength": 1},
              "oracle_kind": {"enum": ["deterministic", "mixed", "blinded_review"]},
              "verification": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string", "minLength": 1}
              }
            },
            "additionalProperties": false
          },
          "controls": {
            "type": "object",
            "required": ["permissions_fingerprint", "tool_surface_fingerprint", "project_rule_refs"],
            "properties": {
              "permissions_fingerprint": {"type": "string", "minLength": 1},
              "tool_surface_fingerprint": {"type": "string", "minLength": 1},
              "project_rule_refs": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "promotion_criteria_ref": {"type": ["string", "null"], "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"purpose": {"const": "policy_promotion"}},
        "required": ["purpose"]
      },
      "then": {
        "required": ["promotion_criteria_ref"],
        "properties": {
          "repeat_policy": {
            "properties": {
              "minimum_completed_per_arm": {"minimum": 3}
            }
          },
          "promotion_criteria_ref": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {
        "properties": {
          "repeat_policy": {
            "properties": {"ordering": {"const": "fixed_with_reason"}},
            "required": ["ordering"]
          }
        }
      },
      "then": {
        "properties": {
          "repeat_policy": {
            "required": ["fixed_order_reason"],
            "properties": {"fixed_order_reason": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  ],
  "$defs": {
    "route": {
      "type": "object",
      "required": ["id", "model", "effort", "sandbox_intent"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"enum": ["minimal", "low", "medium", "high", "xhigh", "max"]},
        "sandbox_intent": {"enum": ["read-only", "workspace-write"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
