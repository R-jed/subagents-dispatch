{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subagents-dispatch experiment run evidence",
  "type": "object",
  "required": [
    "schema_version", "run_id", "campaign_id", "campaign_sha256", "plugin_candidate_sha",
    "stage", "experiment_type", "workload_id", "repeat_index", "arm", "root_thread_id",
    "input_assurance", "input_evidence", "child_materialization", "execution",
    "route_assurance", "permission_state_assurance", "permission_provenance_assurance",
    "provider_control_assurance", "child_routes", "metrics", "evidence_artifact_ref"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "plugin_candidate_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage": {"enum": ["exploratory", "formal"]},
    "experiment_type": {"enum": ["role_calibration", "product_benchmark"]},
    "workload_id": {"type": "string", "minLength": 1},
    "repeat_index": {"type": "integer", "minimum": 1},
    "arm": {"oneOf": [{"$ref": "#/$defs/product_arm"}, {"$ref": "#/$defs/calibration_arm"}]},
    "root_thread_id": {"type": "string", "minLength": 1},
    "input_assurance": {"enum": ["verified", "unknown", "failed"]},
    "input_evidence": {"$ref": "#/$defs/input_evidence"},
    "child_materialization": {"$ref": "#/$defs/child_materialization"},
    "execution": {"$ref": "#/$defs/execution"},
    "route_assurance": {"enum": ["verified", "unknown", "failed", "not_applicable"]},
    "permission_state_assurance": {"enum": ["verified", "unknown", "failed", "not_applicable"]},
    "permission_provenance_assurance": {"enum": ["verified", "unknown", "failed", "not_applicable"]},
    "provider_control_assurance": {"enum": ["verified", "unknown", "failed", "not_applicable"]},
    "child_routes": {"type": "array", "items": {"$ref": "#/$defs/child_route"}},
    "metrics": {"$ref": "#/$defs/metrics"},
    "evidence_artifact_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "role_id": {"enum": ["programmer", "product_manager", "department_director"]},
    "product_arm": {
      "type": "object",
      "required": ["kind", "mode"],
      "properties": {"kind": {"const": "product_benchmark"}, "mode": {"enum": ["single_agent", "dispatch"]}},
      "additionalProperties": false
    },
    "calibration_arm": {
      "type": "object",
      "required": ["kind", "role", "route_id"],
      "properties": {
        "kind": {"const": "role_calibration"},
        "role": {"$ref": "#/$defs/role_id"},
        "route_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scalar_evidence": {
      "type": "object",
      "required": ["observed_value", "verdict", "evidence_ref"],
      "properties": {
        "observed_value": {"type": ["string", "null"]},
        "verdict": {"enum": ["verified", "unknown", "failed", "not_applicable"]},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "host_evidence": {
      "type": "object",
      "required": ["observed", "verdict", "evidence_ref"],
      "properties": {
        "observed": {
          "oneOf": [
            {"type": "object", "required": ["product", "version", "platform"], "properties": {
              "product": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1}
            }, "additionalProperties": false},
            {"type": "null"}
          ]
        },
        "verdict": {"enum": ["verified", "unknown", "failed"]},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "repository_evidence": {
      "type": "object",
      "required": ["observed", "verdict", "evidence_ref"],
      "properties": {
        "observed": {
          "oneOf": [
            {"type": "object", "required": ["repository_url", "base_revision"], "properties": {
              "repository_url": {"type": "string", "minLength": 1}, "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }, "additionalProperties": false},
            {"type": "null"}
          ]
        },
        "verdict": {"enum": ["verified", "unknown", "failed"]},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "control_evidence": {
      "type": "object",
      "required": ["main_session_route", "permissions", "tool_surface", "project_rules"],
      "properties": {
        "main_session_route": {"$ref": "#/$defs/scalar_evidence"},
        "permissions": {"$ref": "#/$defs/scalar_evidence"},
        "tool_surface": {"$ref": "#/$defs/scalar_evidence"},
        "project_rules": {
          "type": "object",
          "required": ["observed_refs", "verdict", "evidence_ref"],
          "properties": {
            "observed_refs": {"oneOf": [{"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, {"type": "null"}]},
            "verdict": {"enum": ["verified", "unknown", "failed"]},
            "evidence_ref": {"type": ["string", "null"]}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "input_evidence": {
      "type": "object",
      "required": ["plugin_candidate", "host", "repository", "task_sha256", "reset_procedure_sha256", "acceptance_sha256", "responsibility_packet_sha256", "controls"],
      "properties": {
        "plugin_candidate": {"$ref": "#/$defs/scalar_evidence"},
        "host": {"$ref": "#/$defs/host_evidence"},
        "repository": {"$ref": "#/$defs/repository_evidence"},
        "task_sha256": {"$ref": "#/$defs/scalar_evidence"},
        "reset_procedure_sha256": {"$ref": "#/$defs/scalar_evidence"},
        "acceptance_sha256": {"$ref": "#/$defs/scalar_evidence"},
        "responsibility_packet_sha256": {"$ref": "#/$defs/scalar_evidence"},
        "controls": {"$ref": "#/$defs/control_evidence"}
      },
      "additionalProperties": false
    },
    "child_materialization": {
      "type": "object",
      "required": ["status", "count", "source_ref"],
      "properties": {
        "status": {"enum": ["observed", "unavailable"]},
        "count": {"type": ["integer", "null"], "minimum": 0},
        "source_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["status", "acceptance_status", "oracle_refs", "quality_score", "quality_score_ref", "result_ref", "failure_ref"],
      "properties": {
        "status": {"enum": ["completed", "failed", "interrupted", "unknown"]},
        "acceptance_status": {"enum": ["passed", "failed", "unknown"]},
        "oracle_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "quality_score": {"type": ["number", "null"], "minimum": 0},
        "quality_score_ref": {"type": ["string", "null"]},
        "result_ref": {"type": ["string", "null"]},
        "failure_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "route_request": {
      "type": "object",
      "required": ["agent_type", "model", "effort", "evidence_ref"],
      "properties": {
        "agent_type": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "route_acceptance": {
      "type": "object",
      "required": ["agent_type", "model", "effort", "verdict", "evidence_ref"],
      "properties": {
        "agent_type": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "effort": {"type": ["string", "null"]},
        "verdict": {"enum": ["verified", "unknown", "failed"]},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "route_observation": {
      "type": "object",
      "required": ["agent_type", "model", "effort", "sandbox_policy_type", "permission_profile_type", "model_provider", "evidence_source", "evidence_ref"],
      "properties": {
        "agent_type": {"type": ["string", "null"]},
        "model": {"type": ["string", "null"]},
        "effort": {"type": ["string", "null"]},
        "sandbox_policy_type": {"type": ["string", "null"]},
        "permission_profile_type": {"type": ["string", "null"]},
        "model_provider": {"type": ["string", "null"]},
        "evidence_source": {"enum": ["native", "local", "both", "none"]},
        "evidence_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "permission_provenance": {
      "type": "object",
      "required": ["source_kind", "source_id", "sandbox_policy_type", "permission_profile_type", "evidence_source", "evidence_ref", "selection_evidence_ref", "verdict"],
      "properties": {
        "source_kind": {"type": ["string", "null"], "enum": [null, "parent_turn", "selected_environment"]},
        "source_id": {"type": ["string", "null"]},
        "sandbox_policy_type": {"type": ["string", "null"]},
        "permission_profile_type": {"type": ["string", "null"]},
        "evidence_source": {"enum": ["native", "local", "both", "none"]},
        "evidence_ref": {"type": ["string", "null"]},
        "selection_evidence_ref": {"type": ["string", "null"]},
        "verdict": {"enum": ["verified", "unknown", "failed"]}
      },
      "additionalProperties": false
    },
    "child_route": {
      "type": "object",
      "required": ["child_thread_id", "parent_thread_id", "role", "requested", "accepted", "observed", "permission_state_verdict", "permission_provenance", "verdict"],
      "properties": {
        "child_thread_id": {"type": "string", "minLength": 1},
        "parent_thread_id": {"type": "string", "minLength": 1},
        "role": {"$ref": "#/$defs/role_id"},
        "requested": {"$ref": "#/$defs/route_request"},
        "accepted": {"$ref": "#/$defs/route_acceptance"},
        "observed": {"$ref": "#/$defs/route_observation"},
        "permission_state_verdict": {"enum": ["verified", "unknown", "failed"]},
        "permission_provenance": {"$ref": "#/$defs/permission_provenance"},
        "verdict": {"enum": ["verified", "unknown", "failed"]}
      },
      "additionalProperties": false
    },
    "measurement": {
      "type": "object",
      "required": ["status", "value", "source_ref"],
      "properties": {
        "status": {"enum": ["observed", "unavailable", "not_applicable"]},
        "value": {"type": ["integer", "null"], "minimum": 0},
        "source_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "metrics": {
      "type": "object",
      "required": ["wall_clock_ms", "main_total_tokens", "child_total_tokens", "aggregate_total_tokens", "main_context_peak_tokens", "user_interventions", "semantic_reworks", "retries", "review_rounds", "compactions"],
      "properties": {
        "wall_clock_ms": {"$ref": "#/$defs/measurement"},
        "main_total_tokens": {"$ref": "#/$defs/measurement"},
        "child_total_tokens": {"$ref": "#/$defs/measurement"},
        "aggregate_total_tokens": {"$ref": "#/$defs/measurement"},
        "main_context_peak_tokens": {"$ref": "#/$defs/measurement"},
        "user_interventions": {"$ref": "#/$defs/measurement"},
        "semantic_reworks": {"$ref": "#/$defs/measurement"},
        "retries": {"$ref": "#/$defs/measurement"},
        "review_rounds": {"$ref": "#/$defs/measurement"},
        "compactions": {"$ref": "#/$defs/measurement"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
