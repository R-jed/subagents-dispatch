{
  "schema_version": "1.0",
  "suite": "subagents-dispatch-interaction-contract",
  "cases": [
    {
      "id": "preview-never-spawns-or-mutates",
      "input": {"selected_skill": "subagents-dispatch", "request": "preview refactor the cache layer"},
      "expected": {
        "mode": "preview",
        "spawn_children": false,
        "provision_agents": false,
        "mutate_source": false,
        "external_action": false,
        "plan_is_provisional": true
      }
    },
    {
      "id": "preview-preserves-visible-material-obligations",
      "input": {
        "selected_skill": "subagents-dispatch",
        "request": "preview a multi-responsibility task with a visible cross-cutting acceptance obligation",
        "material_obligation_visible": true,
        "cross_responsibility_seam_visible": true
      },
      "expected": {
        "mode": "preview",
        "material_obligation_preserved": true,
        "visible_seam_owned": true,
        "main_owned_seam_allowed": true,
        "create_requirement_ledger": false,
        "spawn_decorative_child": false,
        "plan_is_provisional": true
      }
    },
    {
      "id": "first-use-clean-absence-auto-provisions-then-restarts",
      "input": {
        "selected_skill": "subagents-dispatch",
        "request": "implement the bounded cache fix",
        "delegation_worthwhile": true,
        "required_role_available": false,
        "managed_profile_check": "not_installed"
      },
      "expected": {
        "routine_provisioning": true,
        "separate_provisioning_prompt": false,
        "run_installer": true,
        "run_installer_check": true,
        "readiness_outcome": "RESTART_REQUIRED",
        "spawn_children_current_task": false,
        "fresh_task_required": true
      }
    },
    {
      "id": "first-use-exact-profiles-but-role-unavailable-restarts-without-spawn",
      "input": {
        "selected_skill": "subagents-dispatch",
        "request": "implement the bounded cache fix",
        "delegation_worthwhile": true,
        "required_role_available": false,
        "managed_profile_check": "exact"
      },
      "expected": {
        "routine_provisioning": false,
        "readiness_outcome": "RESTART_REQUIRED",
        "spawn_children_current_task": false,
        "fresh_task_required": true
      }
    },
    {
      "id": "first-use-conflicting-managed-state-requires-user-action",
      "input": {
        "selected_skill": "subagents-dispatch",
        "request": "implement the bounded cache fix",
        "delegation_worthwhile": true,
        "required_role_available": false,
        "managed_profile_check": "unowned_conflict"
      },
      "expected": {
        "routine_overwrite": false,
        "readiness_outcome": "USER_ACTION_REQUIRED",
        "spawn_children_current_task": false,
        "doctor_guidance": true
      }
    },
    {
      "id": "custom-role-spawn-requires-fork-turns-none",
      "input": {
        "agent_type": "subagents_dispatch_reader",
        "fork_turns": "all"
      },
      "expected": {
        "spawn_call_valid": false,
        "required_fork_turns": "none",
        "full_history_allowed": false,
        "omitted_fork_turns_allowed": false
      }
    },
    {
      "id": "status-is-one-shot-and-preserves-unknown",
      "input": {"selected_skill": "subagents-dispatch", "request": "status", "native_state": "not_reported"},
      "expected": {
        "mode": "status",
        "poll_loop": false,
        "host_observations": 1,
        "reconciliation_passes": 1,
        "semantic_transitions": 0,
        "reported_state": "UNKNOWN",
        "retry": false,
        "replacement_work": false
      }
    },
    {
      "id": "status-with-no-current-dispatch-does-not-invent-state",
      "input": {"selected_skill": "subagents-dispatch", "request": "status", "current_dispatch": null},
      "expected": {
        "mode": "status",
        "active_responsibilities": 0,
        "reported_unknown_unit": false,
        "search_other_sessions": false
      }
    },
    {
      "id": "status-page-task-is-not-control-status",
      "input": {"selected_skill": "subagents-dispatch", "request": "status page is broken"},
      "expected": {
        "mode": "task",
        "status_control": false
      }
    },
    {
      "id": "targetless-control-one-eligible-auto-resolves",
      "input": {"selected_skill": "steer", "request": "focus on the failing parser case", "eligible_units": ["U2"]},
      "expected": {"target_resolved": true, "resolved_unit": "U2", "requires_choice": false}
    },
    {
      "id": "targetless-control-multiple-eligible-requires-choice",
      "input": {"selected_skill": "takeover", "request": "take over", "eligible_units": ["U1", "U2"]},
      "expected": {"target_resolved": false, "candidates": ["U1", "U2"], "requires_choice": true}
    },
    {
      "id": "steer-preserves-responsibility-and-authority",
      "input": {"selected_skill": "subagents-dispatch", "request": "steer U2: inspect the crash log before retrying the parser", "unit_state": "RUNNING"},
      "expected": {
        "mode": "steer",
        "same_unit": true,
        "same_attempt": true,
        "same_role": true,
        "authority_expands": false
      }
    },
    {
      "id": "steer-interrupted-is-not-resume",
      "input": {"selected_skill": "steer", "request": "continue", "unit_state": "INTERRUPTED"},
      "expected": {"target_resolved": false, "resume_claimed": false, "replacement_children": 0}
    },
    {
      "id": "steer-cannot-hide-material-scope-change",
      "input": {"selected_skill": "subagents-dispatch", "request": "steer U2: also redesign the public API and write the migration"},
      "expected": {
        "mode": "steer_rejected_as_scope_change",
        "requires_main_reclassification": true,
        "silent_authority_expansion": false
      }
    },
    {
      "id": "control-target-missing-fails-closed",
      "input": {"selected_skill": "subagents-dispatch", "request": "takeover U99", "known_units": ["U1", "U2"]},
      "expected": {
        "target_resolved": false,
        "ownership_transferred": false,
        "invent_agent_id": false,
        "search_other_sessions": false
      }
    },
    {
      "id": "takeover-running-writer-settles-old-owner-first",
      "input": {"selected_skill": "subagents-dispatch", "request": "takeover U2", "unit_state": "RUNNING", "unit_write": true},
      "expected": {
        "mode": "takeover",
        "request_native_stop": true,
        "main_write_before_stop_confirmation": false,
        "preserve_one_writer": true
      }
    },
    {
      "id": "takeover-unknown-owner-does-not-force-transfer",
      "input": {"selected_skill": "subagents-dispatch", "request": "takeover U2", "unit_state": "UNKNOWN", "unit_write": true},
      "expected": {
        "mode": "takeover_pending",
        "ownership_transferred": false,
        "main_conflicting_write": false,
        "reported_state": "UNKNOWN"
      }
    },
    {
      "id": "receipt-after-materialized-delegation",
      "input": {"children_spawned": 2, "roles": ["reader", "worker"], "retries": 0, "final_review": "not_required"},
      "expected": {
        "receipt": true,
        "axes": ["Dispatch", "Review"],
        "uses_public_activities": true,
        "may_report_retries": true,
        "may_report_review_state": true
      }
    },
    {
      "id": "pre-child-spawn-rejection-does-not-count-as-retry",
      "input": {
        "first_spawn_rejected": true,
        "first_spawn_child_identity": null,
        "corrected_spawn_child_identity": "agent-1"
      },
      "expected": {
        "materialized_agent_attempts": 1,
        "retry_count": 0,
        "receipt_retry": "no_retry",
        "consume_attempt_budget_on_rejection": false
      }
    },
    {
      "id": "blocked-delegated-outcome-still-has-receipt",
      "input": {"children_spawned": 1, "terminal_result": "blocked", "state": "UNKNOWN", "final_review": "not_reached"},
      "expected": {
        "receipt": true,
        "axes": ["Dispatch", "Review"],
        "may_report_blocker": true,
        "must_preserve_unknown": true
      }
    },
    {
      "id": "zero-child-dispatch-has-minimal-receipt",
      "input": {"explicit_dispatch": true, "children_spawned": 0},
      "expected": {"receipt": true, "minimal_lines": 2, "persistent_state": false}
    },
    {
      "id": "receipt-never-guesses-model-or-cost",
      "input": {"children_spawned": 1, "configured_model": "gpt-5.6-luna", "observed_model": null, "token_usage": null},
      "expected": {
        "claim_observed_model": false,
        "estimate_tokens": false,
        "estimate_currency_cost": false
      }
    },
    {
      "id": "handoff-capsule-promotes-only-accepted-evidence",
      "input": {
        "child_claim": "cache invalidation is safe",
        "main_verified": false,
        "other_verified_fact": "the call path enters cache.py before store.py"
      },
      "expected": {
        "claim_in_accepted_facts": false,
        "verified_fact_may_enter_capsule": true,
        "raw_child_transcript_forwarded": false
      }
    },
    {
      "id": "handoff-capsule-invalidates-on-relevant-drift",
      "input": {"capsule_depends_on": ["src/cache.py"], "mutated_after_acceptance": ["src/cache.py"]},
      "expected": {
        "capsule_still_authoritative": false,
        "narrow_reverification_required": true
      }
    },
    {
      "id": "handoff-capsule-does-not-grant-write-authority",
      "input": {"capsule_mentions": ["src/cache.py"], "packet_mutation_authority": "none"},
      "expected": {
        "source_write_allowed": false,
        "capsule_can_expand_authority": false
      }
    },
    {
      "id": "missing-thread-id",
      "input": {"selected_skill": "status", "thread_id": null, "state_root": "present"},
      "expected": {"reported_state": "UNKNOWN", "state_created": false, "search_other_sessions": false}
    },
    {
      "id": "spawn-pending-no-match",
      "input": {"unit_state": "SPAWN_PENDING", "native_children": []},
      "expected": {"state": "UNKNOWN", "quarantine_reason": "native_identity_absent", "replacement_attempt": false}
    },
    {
      "id": "spawn-pending-single-match",
      "input": {
        "unit_state": "SPAWN_PENDING",
        "native_children": [{"native_task_name": "sd-u1-a1-execute", "agent_id": "agent-1", "state": "running"}]
      },
      "expected": {"state": "RUNNING", "identity_bound": true, "replacement_attempt": false}
    },
    {
      "id": "spawn-pending-multiple-match",
      "input": {
        "unit_state": "SPAWN_PENDING",
        "native_children": [
          {"native_task_name": "sd-u1-a1-execute", "agent_id": "agent-1", "state": "running"},
          {"native_task_name": "sd-u1-a1-execute", "agent_id": "agent-2", "state": "running"}
        ]
      },
      "expected": {"state": "UNKNOWN", "quarantine_reason": "ambiguous_native_identity", "replacement_attempt": false}
    },
    {
      "id": "corrupt-capsule-active-writer",
      "input": {"capsule": "corrupt", "writer_state": "RUNNING"},
      "expected": {"state": "UNKNOWN", "writer_preserved": true, "automatic_deletion": false, "main_write_allowed": false}
    },
    {
      "id": "multi-targetless-steer",
      "input": {"control": "Steer", "target": null, "eligible_units": ["U1", "U2"]},
      "expected": {"resolved": false, "requires_choice": true, "replacement_children": 0}
    },
    {
      "id": "single-targetless-steer",
      "input": {"control": "Steer", "target": null, "eligible_units": ["U1"]},
      "expected": {"resolved": true, "resolved_unit": "U1", "same_attempt": true}
    },
    {
      "id": "interrupted-takeover",
      "input": {"control": "Takeover", "unit_state": "INTERRUPTED", "unit_write": true},
      "expected": {"ownership_transferred": false, "main_write_allowed": false, "resume_required": true}
    },
    {
      "id": "fix-first-without-correction",
      "input": {"review_verdict": "fix-first", "correction_started": false},
      "expected": {"candidate_complete": false, "ship_allowed": false, "fresh_review_required": true}
    },
    {
      "id": "retry-then-rework",
      "input": {"retry_materialized": true, "review_found_gap": true, "correction_started": true},
      "expected": {"retry_count": 1, "rework_count": 1, "retry_is_not_rework": true}
    },
    {
      "id": "locale-persistence",
      "input": {"initial_locale": "zh", "follow_up_control": "Status", "follow_up_locale": null},
      "expected": {"receipt_locale": "zh", "control_labels": ["Status"], "language_switched": false}
    },
    {
      "id": "unrelated-dispatch-with-unresolved-writer",
      "input": {"current_thread": "thread-a", "other_thread_writer_state": "UNKNOWN"},
      "expected": {"other_writer_deleted": false, "current_ownership_expanded": false, "writer_preserved": true}
    },
    {
      "id": "repeated-status-dedupe",
      "input": {"events": ["Status", "Status", "Status"], "same_observation": true},
      "expected": {"control_count": 1, "work_pass_count": 0, "receipt_deduplicated": true}
    },
    {
      "id": "same-child-resume",
      "input": {"unit_state": "INTERRUPTED", "same_agent_id": "agent-1", "resume_requested": true},
      "expected": {"operation": "resume_existing_child", "new_child": false, "attempt_changed": false}
    },
    {
      "id": "route-mismatch",
      "input": {
        "requested": {"agent_role": "reader", "model": "gpt-5.6-luna", "effort": "max"},
        "accepted": {"agent_role": "reader", "model": "gpt-5.6-luna", "effort": "max"},
        "observed": {"agent_role": "worker", "model": "gpt-5.6-luna", "effort": "max"}
      },
      "expected": {"route_status": "conflict", "decision": "quarantine", "configuration_is_not_observed": true}
    }
  ]
}
