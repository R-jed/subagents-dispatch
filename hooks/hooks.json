{
  "description": "Validate subagents-dispatch managed spawn_agent calls against prepared Dispatch state.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "spawn_agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run-python.sh\" \"${PLUGIN_ROOT}/scripts/spawn_guard.py\"",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-python.cmd\" \"%PLUGIN_ROOT%\\scripts\\spawn_guard.py\"",
            "timeout": 5,
            "async": false
          }
        ]
      }
    ]
  }
}
