{
  "schema_version": 10,
  "delegation": {
    "max_depth": 1,
    "fork_turns": "none",
    "max_managed_children": 4
  },
  "write_coordination": {
    "mode": "single_writer",
    "scope": "canonical_workspace"
  },
  "permission_semantics": {
    "candidate_source_kinds": [
      "selected_environment",
      "parent_turn"
    ]
  },
  "roles": {
    "programmer": {
      "profile_file": "subagents-dispatch-programmer.toml",
      "agent_type": "subagents_dispatch_programmer",
      "model": "gpt-5.6-luna",
      "allowed_efforts": [
        "max"
      ]
    },
    "product_manager": {
      "profile_file": "subagents-dispatch-product-manager.toml",
      "agent_type": "subagents_dispatch_product_manager",
      "model": "gpt-5.6-sol",
      "allowed_efforts": [
        "medium",
        "high"
      ]
    },
    "department_director": {
      "profile_file": "subagents-dispatch-department-director.toml",
      "agent_type": "subagents_dispatch_department_director",
      "model": "gpt-6-astra",
      "allowed_efforts": [
        "high"
      ]
    }
  },
  "decision_routing": {
    "role_id": "product_manager",
    "default_effort": "medium",
    "high_effort": "high",
    "high_triggers": [
      "architecture_boundary",
      "public_contract",
      "compatibility",
      "ownership_authority",
      "persistent_semantics",
      "security_or_authorization",
      "data_integrity",
      "concurrency_semantics",
      "migration"
    ]
  },
  "review_routing": {
    "standard": {
      "role_id": "product_manager",
      "effort": "high",
      "triggers": [
        "user_requested_review",
        "public_contract_change",
        "material_behavior_change",
        "persistent_state_change",
        "verification_gap"
      ]
    },
    "highest": {
      "role_id": "department_director",
      "effort": "high",
      "triggers": [
        "security_boundary",
        "authorization_boundary",
        "data_integrity",
        "critical_concurrency_or_ownership",
        "migration",
        "irreversible_external_effect",
        "release",
        "user_requested_highest_assurance"
      ]
    }
  },
  "review_verdicts": {
    "ship": "ship",
    "correction": [
      "fix-first",
      "rethink"
    ],
    "unresolved": "insufficient_evidence"
  }
}
