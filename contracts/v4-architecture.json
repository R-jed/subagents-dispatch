{
  "authorities": {
    "mutation_authority_values": [
      "none",
      "declared-output-only",
      "bounded-source-write"
    ],
    "writer_effect_values": [
      "NONE",
      "RESERVE",
      "RETAIN",
      "REVOKE"
    ],
    "writer_owner_kinds": [
      "main",
      "execution"
    ]
  },
  "control_semantics": {
    "CONTINUE": {
      "host_primitive": "followup",
      "increments_attempt": false,
      "increments_followup_count": false
    },
    "FOLLOWUP": {
      "host_primitive": "followup",
      "increments_attempt": false,
      "increments_followup_count": true
    },
    "INTERRUPT": {
      "host_primitive": "interrupt",
      "interrupt_ack_releases_writer": false,
      "requires_fresh_post_control_observation": true
    },
    "TAKEOVER": {
      "host_primitive": "composite",
      "requires_writer_settlement_before_main_acquire": true
    }
  },
  "delegation": {
    "fork_turns": "none",
    "host_capacity_excludes_primary": true,
    "initial_managed_children_max": 2,
    "max_depth": 1,
    "product_managed_children_max": 3
  },
  "entities": {
    "ExecutionBinding": {
      "fields": [
        "execution_id",
        "unit_id",
        "team_plan_revision",
        "attempt_no",
        "profile_id",
        "agent_id",
        "native_task_name",
        "model",
        "effort",
        "granted_authority",
        "granted_write_scope",
        "workspace_id",
        "lifecycle",
        "control_epoch",
        "followup_count",
        "failure_origin",
        "blocker",
        "quarantine_reason"
      ]
    },
    "PendingControl": {
      "fields": [
        "control_id",
        "unit_id",
        "execution_id",
        "operation",
        "target",
        "payload_digest",
        "expected_team_plan_revision",
        "expected_control_epoch",
        "next_control_epoch",
        "expected_lease_epoch",
        "writer_effect",
        "state",
        "tool_use_id"
      ],
      "operations": [
        "SPAWN",
        "FOLLOWUP",
        "CONTINUE",
        "INTERRUPT"
      ]
    },
    "WorkUnit": {
      "fields": [
        "unit_id",
        "intent",
        "goal",
        "output",
        "depends_on",
        "state",
        "ownership",
        "authority_ceiling",
        "write_scope_ceiling",
        "done_when",
        "accepted_result_ref",
        "accepted_execution_id",
        "accepted_control_epoch"
      ]
    },
    "WriterLease": {
      "fields": [
        "lease_id",
        "lease_epoch",
        "workspace_id",
        "unit_id",
        "owner_kind",
        "owner_id",
        "state"
      ]
    }
  },
  "excluded_from_v4_0_0": [
    "dynamic_reasoning_effort",
    "nested_delegation",
    "automatic_worktree_manager",
    "parallel_isolated_writers",
    "peer_delegation",
    "persistent_scheduler_database",
    "daemon_scheduler"
  ],
  "execution": {
    "control_epoch_scope": "execution_binding",
    "fresh_agent_attempt_limit": 2,
    "same_child_followup_consumes_fresh_attempt": false,
    "states": [
      "SPAWN_PENDING",
      "RUNNING",
      "INTERRUPTED",
      "COMPLETED",
      "FAILED",
      "UNKNOWN",
      "CLOSED"
    ]
  },
  "guard": {
    "host_hook_coverage_is_release_gate": true,
    "managed_lifecycle_authority_owner": "main",
    "post_tool_use_acknowledges_control": true,
    "pre_tool_use_consumes_prepared_control": true,
    "subagent_stop_forces_no_auto_continue": true
  },
  "host_capability_requirements": [
    "spawn",
    "observe",
    "wait_or_wakeup",
    "followup",
    "interrupt",
    "pre_tool_use_guard",
    "post_tool_use_guard",
    "subagent_stop_veto"
  ],
  "invariants": {
    "I01": "A canonical workspace has at most one managed writer lease in RESERVED, HELD, REVOKING, or UNKNOWN.",
    "I02": "Host COMPLETED never directly marks a WorkUnit ACCEPTED or unlocks dependencies.",
    "I03": "Dependencies unlock only from WorkUnit ACCEPTED.",
    "I04": "A Host observation whose execution_id, control_epoch, or lease_epoch basis is stale is discarded.",
    "I05": "One PendingControl authorization is consumed at most once and is bound to one tool_use_id.",
    "I06": "Only one unresolved PendingControl may exist per ExecutionBinding.",
    "I07": "A writing followup or continue must reserve or retain the WriterLease before Host reactivation.",
    "I08": "interrupt acknowledgement alone never releases a WriterLease.",
    "I09": "UNKNOWN writer ownership blocks conflicting managed mutation.",
    "I10": "Managed children cannot spawn, followup, interrupt, resume, or otherwise control sibling managed agents.",
    "I11": "Peer messages cannot grant authority, transfer WriterLease, satisfy acceptance, or unlock dependencies.",
    "I12": "Unresolved V3.x live state is never silently migrated into V4 execution.",
    "I13": "Plan-only orchestration never acquires a WriterLease.",
    "I14": "Main must acquire the same WriterLease abstraction before managed integration writes."
  },
  "migration": {
    "silent_live_state_migration": false,
    "source_family": "V3.x",
    "unresolved_live_state": "fail_closed"
  },
  "pending_control": {
    "payload_binding": "sha256_canonical_tool_input",
    "serial_per_execution": true,
    "single_use_binding": "tool_use_id",
    "states": [
      "PREPARED",
      "IN_FLIGHT",
      "ACKED",
      "UNKNOWN",
      "CANCELLED"
    ]
  },
  "profiles": {
    "advisor": {
      "effort": "high",
      "model": "gpt-5.6-sol",
      "mutation_authority": "none",
      "semantic_role": "review"
    },
    "investigator": {
      "effort": "high",
      "model": "gpt-5.6-terra",
      "mutation_authority": "none",
      "semantic_role": "work"
    },
    "reader": {
      "effort": "max",
      "model": "gpt-5.6-luna",
      "mutation_authority": "none",
      "semantic_role": "work"
    },
    "solver": {
      "effort": "high",
      "model": "gpt-5.6-sol",
      "mutation_authority": "bounded-source-write",
      "semantic_role": "work"
    },
    "worker": {
      "effort": "max",
      "model": "gpt-5.6-luna",
      "mutation_authority": "bounded-source-write",
      "semantic_role": "work"
    }
  },
  "public_skills": [
    "orchestrate",
    "doctor"
  ],
  "reconciliation": {
    "host_completed_maps_to_work_unit": "RESULT_READY",
    "mode": "wakeup_driven",
    "observation_basis": [
      "execution_id",
      "control_epoch",
      "lease_epoch"
    ],
    "stale_observation_action": "discard"
  },
  "review": {
    "artifact_mutation_invalidates_verdict": true,
    "exact_artifact_binding": true,
    "fresh_reviewer": true,
    "reviewer_profile": "advisor"
  },
  "routing": {
    "dynamic_reasoning_effort": false,
    "peer_messaging_on_correctness_path": false,
    "principle": "lowest_eligible_capability_profile"
  },
  "schema_version": "4.0.0-freeze-1",
  "semantic_roles": [
    "main",
    "work",
    "review"
  ],
  "state": {
    "bounded_bytes": 65536,
    "compact_work_graph": true,
    "database": false,
    "raw_prompts_or_transcripts": false,
    "state_revision": true,
    "storage": "active.json",
    "temporary_thread_scoped": true,
    "top_level_fields": [
      "schema_version",
      "root_session_id",
      "state_revision",
      "team_plan_revision",
      "work_units",
      "executions",
      "writer_lease",
      "pending_controls",
      "accounting_refs",
      "created_at",
      "updated_at",
      "locale"
    ]
  },
  "work_unit": {
    "dependency_unlock_state": "ACCEPTED",
    "host_completed_unlocks_dependency": false,
    "states": [
      "BLOCKED",
      "READY",
      "EXECUTING",
      "RESULT_READY",
      "VERIFYING",
      "ACCEPTED",
      "REJECTED",
      "CANCELLED"
    ]
  },
  "writer_lease": {
    "blocking_states": [
      "RESERVED",
      "HELD",
      "REVOKING",
      "UNKNOWN"
    ],
    "main_requires_lease_for_managed_write": true,
    "parallel_isolated_writers_v4": false,
    "scope": "canonical_workspace",
    "states": [
      "RESERVED",
      "HELD",
      "REVOKING",
      "UNKNOWN",
      "RELEASED"
    ]
  }
}
